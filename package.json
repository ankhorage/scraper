{
  "name": "@ankhorage/scraper",
  "version": "0.2.0",
  "description": "Safe, bounded browser observations for public websites.",
  "license": "MIT",
  "keywords": [
    "ankhorage",
    "browser-observation",
    "crawler",
    "puppeteer",
    "recognition",
    "scraper"
  ],
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/scraper.git"
  },
  "homepage": "https://github.com/ankhorage/scraper#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/scraper/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js"
    },
    "./types": {
      "types": "./dist/types/public.d.ts",
      "import": "./dist/types/public.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "ankh": {
    "category": "scraper",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      {
        "id": "scraper.crawl",
        "owner": "@ankhorage/scraper",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Crawl website",
        "description": "Capture bounded browser observations for a public website."
      }
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "bun run check-types",
    "test": "bun test src",
    "test:standalone": "bun run build && bun test src/standalone.test.ts",
    "docs": "paradox",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip"
  },
  "dependencies": {
    "@ankhorage/ankh": "^0.13.4",
    "@ankhorage/capability": "^0.2.2",
    "@ankhorage/contracts": "^26.6.0",
    "puppeteer": "^24.4.0"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^2.4.3",
    "@ankhorage/paradox": "^0.3.6",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
